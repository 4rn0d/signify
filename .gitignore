# ---------------------------------------------------------------
# Datasets (~1.5 Go) - regenerables
#   data/raw/       : telecharge (ASL Alphabet)
#   data/processed/ : genere par src/prepare_segmented_dataset.py
# ---------------------------------------------------------------
data/raw/*
data/processed/*
data/landmarks/*
!data/**/.gitkeep

# ---------------------------------------------------------------
# Artefacts entraines - regeneres par src/train.py (~11 min)
# class_names.json est garde : petit et utile comme metadonnee.
# ---------------------------------------------------------------
# Motifs sans prefixe de dossier : "models/*.keras" ne descend pas dans
# les sous-dossiers et laisserait passer models/archive/*.keras (18 Mo).
*.keras
*.tflite
*.h5

# Modele MediaPipe : re-telecharge automatiquement par HandSegmenter
models/hand_landmarker.task
hand_landmarker.task

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# ---------------------------------------------------------------
# Sauvegardes / editeur
# ---------------------------------------------------------------
*.bak
.vscode/

# WLASL : videos et metadata. Le JSON fait 11.9 Mo et se retelecharge avec
#   curl -sSL -o data/wlasl/WLASL_v0.3.json #     https://raw.githubusercontent.com/dxli94/WLASL/master/start_kit/WLASL_v0.3.json
data/wlasl/
